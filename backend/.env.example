NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/cashback_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=cashback-receipts
S3_PRESIGN_EXPIRY=300        # seconds — how long the presigned upload URL is valid

# OCR Provider (Veryfi)
OCR_PROVIDER=veryfi           # or 'textract'
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=

# Fraud thresholds
FRAUD_AUTO_APPROVE_MAX=29     # score ≤ this → auto-approve
FRAUD_AUTO_REJECT_MIN=70      # score ≥ this → auto-reject (else manual review)

# Claim submission window (days)
CLAIM_WINDOW_DAYS=7
